# Copy to .env.local and use the web app configuration from Firebase Console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional. Defaults to /admin.
VITE_LOGIN_URL=/admin

# Set to cloudinary to use the Vercel upload function (otherwise Firebase Storage).
VITE_MEDIA_PROVIDER=cloudinary

# SERVER ONLY: configure these in Vercel, never prefix with VITE_.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FIREBASE_PROJECT_ID=jls-carpentry
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Places API (used to load real Google Reviews)
# Restrict this key by HTTP referrer in Google Cloud Console.
VITE_GOOGLE_PLACES_API_KEY=
VITE_GOOGLE_PLACE_ID=
# Optional for Service Area Business: use business name + area to resolve Place ID
# Example: JLS Carpentry Sydney
VITE_GOOGLE_BUSINESS_QUERY=

# Optional fallback query used when the primary query does not resolve a Place ID
VITE_GOOGLE_BUSINESS_QUERY_FALLBACK=
