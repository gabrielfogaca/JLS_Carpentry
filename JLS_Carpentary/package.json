    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^8.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "oxfmt": "^0.2.0",
    "typescript": "^5.7.0"
